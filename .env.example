# Binance API Credentials
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here  # For HMAC authentication
BINANCE_TESTNET=true

# Ed25519 Authentication (more secure, recommended)
USE_ED25519=false  # Set to true to use Ed25519 instead of HMAC
ED25519_PRIVATE_KEY_PATH=  # Path to your Ed25519 private key PEM file
ED25519_KEY_PASSWORD=  # Password if your key is encrypted (optional)

# Database
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=binance_bot
POSTGRES_USER=bot_user
POSTGRES_PASSWORD=your_secure_password

# Telegram Alerts
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# Risk Parameters
MAX_POSITION_SIZE_USD=1000
MAX_TOTAL_EXPOSURE_USD=5000
MAX_DAILY_LOSS_USD=200
CIRCUIT_BREAKER_LOSS_PERCENT=5.0

# Trading Pairs (comma-separated)
TRADING_PAIRS=BTCUSDT,ETHUSDT,BNBUSDT

# Environment
LOG_LEVEL=INFO
ENVIRONMENT=development
